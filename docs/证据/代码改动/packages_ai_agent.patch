+/*
+ * 轮询检测 Wi-Fi 是否完成关联。ESP32-S3 首次关联的 4 次握手常失败，此时
+ * SIOCGIWAP 返回的 BSSID 为全 0 或全 0xff；握手成功后才是真实 AP MAC。
+ * 用它替代盲目 usleep：既能确认关联成功再走 DHCP，也能在握手失败时尽早
+ * 进入下一轮重置重连。timeout_ms 内关联成功返回 true，否则 false。
+ */
+static bool wifi_wait_associated(const char* dev, int timeout_ms)
+{
+    int sock = socket(AF_INET, SOCK_DGRAM, 0);
+    if (sock < 0) {
+        return false;
+    }
+
+    bool associated = false;
+    for (int elapsed = 0; elapsed < timeout_ms; elapsed += 500) {
+        struct iwreq req;
+        memset(&req, 0, sizeof(req));
+        strncpy(req.ifr_name, dev, IFNAMSIZ);
+
+        if (ioctl(sock, SIOCGIWAP, (unsigned long)&req) == 0) {
+            const unsigned char* bssid =
+                (const unsigned char*)req.u.ap_addr.sa_data;
+            bool all_zero = true;
+            bool all_ff = true;
+            for (int i = 0; i < 6; i++) {
+                if (bssid[i] != 0x00) {
+                    all_zero = false;
+                }
+                if (bssid[i] != 0xff) {
+                    all_ff = false;
+                }
+            }
+            if (!all_zero && !all_ff) {
+                associated = true;
+                break;
+            }
+        }
+
+        usleep(500000); /* 每 500ms 轮询一次 */
+    }
+
+    close(sock);
+    return associated;
+}
